# Powerteck Manufacturing Website Environment Configuration

# Public Website URL
NEXT_PUBLIC_SITE_URL=https://powerteck.in

# Configurable WhatsApp Business Number (in E.164 format without '+' or dashes, e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# Direct Voice Contact
NEXT_PUBLIC_CONTACT_PHONE=+919876543210

# Supabase Integration (Optional - app runs with rich local mock data when omitted)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-Side Only Keys (NEVER expose to client with NEXT_PUBLIC_)
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
